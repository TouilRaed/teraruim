# --- Database ---
# Local dev: SQLite (default)
DATABASE_URL="file:./dev.db"
# Production (Postgres on Neon / Supabase / Vercel Marketplace):
# DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# --- Admin panel ---
# Login URL: /admin/login
# Strong random password. Generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
# HMAC secret for admin session cookies. 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="CHANGE_ME_64_HEX_RANDOM"
# Optional IP allowlist (comma-separated). Leave empty to allow any IP.
ADMIN_IP_ALLOWLIST=""
# Optional TOTP 2FA secret (base32). Empty disables 2FA. Setup at /admin/setup-2fa
ADMIN_TOTP_SECRET=""

# --- Image uploads (Vercel Blob) ---
# REQUIRED in production. Provision: Vercel dashboard > project > Storage > Blob,
# connect to project (auto-sets this), then REDEPLOY. Without it, product image
# uploads fail (serverless filesystem is read-only). Local dev without this token
# falls back to writing /public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Order tracking URLs ---
# HMAC secret for signing guest order URLs. 64 hex chars.
ORDER_URL_SECRET="CHANGE_ME_64_HEX_RANDOM"

# --- Meta Pixel / Conversions API ---
# Browser Pixel. MUST have NEXT_PUBLIC_ prefix — inlined at BUILD time, so set
# it in Vercel BEFORE building and REDEPLOY after any change. Without it the
# Pixel snippet never renders and no PageView fires.
NEXT_PUBLIC_META_PIXEL_ID=""
# Server-side Conversions API (same numeric Pixel ID, no NEXT_PUBLIC_ prefix).
META_PIXEL_ID=""
# CAPI access token from Events Manager > Settings > Conversions API.
META_CAPI_TOKEN=""

# --- Shipper.network (optional) ---
# ADEX courier (adex.tn) — your account login + password
ADEX_USER=""
ADEX_PWD=""

# --- Intigo courier (partner API key from Intigo) ---
INTIGO_API_KEY=""
INTIGO_PICKUP_INDEX="1"
